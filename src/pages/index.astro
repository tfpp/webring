---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import MemberCard from '../components/MemberCard.astro';
import { members } from '../data/ring';
const count = String(members.length).padStart(2, '0');
---
<Base>
  <a class="skip-link" href="#main">Skip to content</a>
  <div class="shell">
    <header class="site-header">
      <Logo homeLink={false} />
      <span class="header-note">WEBRING / {count}</span>
    </header>
    <main id="main">
      <section class="hero" aria-labelledby="headline">
        <h1 id="headline">The Fake Place</h1>
      </section>
      <section aria-labelledby="members-heading">
        <div class="section-heading">
          <h2 id="members-heading">MEMBERS</h2>
          <span class="count" aria-label={`${members.length} members`}>{count}</span>
        </div>
        <ul class="cards" role="list">
          {members.map((member, index) => <MemberCard member={member} index={index} />)}
        </ul>
      </section>
    </main>
    <footer class="site-footer">tfpp.pw</footer>
  </div>
</Base>
